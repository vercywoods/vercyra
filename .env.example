# SMTP alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_RECIPIENT=alerts@example.com

# PayPal REST API (sandbox by default)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
PAYPAL_PLAN_STARTER=replace-with-starter-plan-id
PAYPAL_PLAN_PRO=replace-with-pro-plan-id
PAYPAL_PLAN_BUSINESS=replace-with-business-plan-id
VERCYRA_PUBLIC_URL=http://localhost:4173
PAYPAL_WEBHOOK_URL=https://example.com/api/paypal/webhook
VERCYRA_SESSION_SECRET=generate-a-long-random-value
VERCYRA_DASHBOARD_PASSWORD_HASH=generate-with-py-passenger_wsgi.py

# Express API configuration
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vercyra
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local-only checkout/webhook simulation. These are flags, not provider credentials.
BILLING_SIMULATOR_ENABLED=false
PAYPAL_SIMULATOR_ENABLED=false
STRIPE_SIMULATOR_ENABLED=false
